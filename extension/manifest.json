{
  "manifest_version": 3,
  "name": "X Slop Detector — research client",
  "version": "0.4.0",
  "description": "Thin client for a dedicated multi-detector server. No calibrated percentage is available yet.",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "X Slop Detector", "default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["shared.js", "extraction.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
